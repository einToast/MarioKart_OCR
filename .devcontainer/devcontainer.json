{
  "name": "MarioKart OCR Dev Container",
  "image": "mcr.microsoft.com/devcontainers/python:3.15-trixie",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1.1.4": {}
  },
  "forwardPorts": [
    8001
  ],
  "portsAttributes": {
    "8001": {
      "label": "OCR service"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "github.vscode-pull-request",
        "yzhang.markdown-all-in-one",
        "vscode-icons-team.vscode-icons"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "containerEnv": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "remoteEnv": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "remoteUser": "vscode"
}
